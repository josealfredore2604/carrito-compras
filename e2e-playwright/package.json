{
  "name": "e2e-playwright-tiendauv",
  "version": "1.0.0",
  "description": "Suite E2E principal con Playwright para el carrito de TiendaUV",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
